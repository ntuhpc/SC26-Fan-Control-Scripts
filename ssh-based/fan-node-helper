#!/bin/bash
# Install root-owned as /usr/local/sbin/fan-node-helper.
set -euo pipefail
LOCK=/run/lock/fan-node-helper.lock
NODE=$(hostname -s | tr '[:upper:]' '[:lower:]')

if [[ $# -eq 1 && $1 == check ]]; then
    [[ $NODE == coffeepot1 || $NODE == coffeepot3 ]] || { echo "unsupported host: $NODE" >&2; exit 2; }
    command -v ipmitool >/dev/null || { echo "ipmitool not found" >&2; exit 2; }
    echo "$NODE helper ready"
    exit 0
fi

[[ $# -eq 3 && $1 == set ]] || { echo "usage: fan-node-helper set ZONE PERCENT" >&2; exit 2; }
zone=$2
percent=$3
[[ $zone == 0 || $zone == 1 ]] || { echo "zone must be 0 or 1" >&2; exit 2; }
[[ $percent =~ ^[0-9]{1,3}$ ]] && (( percent <= 100 )) || { echo "percent must be 0 through 100" >&2; exit 2; }
[[ $NODE == coffeepot1 || $NODE == coffeepot3 ]] || { echo "unsupported host: $NODE" >&2; exit 2; }
command -v ipmitool >/dev/null || { echo "ipmitool not found" >&2; exit 2; }

exec 9>"$LOCK"
flock -x 9
if [[ $NODE == coffeepot1 ]]; then
    speed=$(printf '0x%02x' "$percent")
    ipmitool raw 0x30 0x45 0x01 0x01
    ipmitool raw 0x30 0x70 0x66 0x01 "0x0${zone}" "$speed"
else
    ipmitool raw 0x30 0x70 0x66 2 1
    ipmitool raw 0x30 0x70 0x66 1 "$zone" "$percent"
fi
echo "$NODE zone $zone set to $percent%"
